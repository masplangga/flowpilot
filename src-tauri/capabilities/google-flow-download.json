{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "google-flow-download",
  "description": "Allows isolated Google Flow account WebViews to use only the local video download coordinator.",
  "local": false,
  "remote": {
    "urls": [
      "https://flow.google",
      "https://flow.google/*",
      "https://labs.google/*",
      "https://www.dola.com",
      "https://www.dola.com/*",
      "https://migoo.ai",
      "https://migoo.ai/*"
    ]
  },
  "webviews": ["google-flow-*", "dola-*", "migoo-*"],
  "permissions": [
    "allow-begin-blob-download",
    "allow-write-blob-download-chunk",
    "allow-complete-blob-download",
    "allow-cancel-blob-download"
  ]
}
